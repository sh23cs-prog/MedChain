# ==============================================================================
# MedChain - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_DB=medchaindb
POSTGRES_USER=medchain
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ─── Security & Cryptography ─────────────────────────────────────────────────
# 256-bit secret for signing HMAC-SHA256 JWT tokens
JWT_SECRET=your_production_super_secret_jwt_key_minimum_256_bits_length_here
# 256-bit key for AES-256-GCM symmetric medical record encryption
AES_SECRET_KEY=Your32ByteSecretKeyForAES256GCM!!

# ─── Email Provider Selection (AUTO | RESEND | BREVO | SMTP) ─────────────────
MAIL_PROVIDER=AUTO
SPRING_MAIL_FROM=onboarding@resend.dev

# ─── Resend Transactional Email (HTTPS API port 443) ─────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ─── Brevo Transactional Email (HTTPS API port 443) ──────────────────────────
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@domain.com
BREVO_FROM_NAME=MedChain Security

# ─── Traditional SMTP Fallback (e.g. Gmail App Password) ──────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_16_character_google_app_password

# ─── Hardhat Local EVM Blockchain Network ────────────────────────────────────
# Standard Hardhat Test Account #0 (Safe for local permissioned EVM test network)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ─── Frontend Build Arguments ─────────────────────────────────────────────────
REACT_APP_MOCK_MODE=false
REACT_APP_API_URL=
